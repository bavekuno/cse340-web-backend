<%- include('partials/header') %>

<main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <% organizations.forEach(organization=> { %>
                <li>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.name %>
                    </a>
                </li>
                <% }); %>
        </ul>

        <p>
            <a href="/new-organization">Add New Organization</a>
        </p>
    </main>

    <%- include('partials/footer') %>