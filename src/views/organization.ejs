<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="org-header">
            <% if (organizationDetails.logo_filename) { %>
                <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo"
                    class="org-logo">
                <% } %>

                    <h2>
                        <%= organizationDetails.name %>
                    </h2>
        </div>

        <p>
            <strong>Description:</strong>
            <%= organizationDetails.description %>
        </p>

        <p>
            <strong>Email:</strong>
            <a href="mailto:<%= organizationDetails.contact_email %>">
                <%= organizationDetails.contact_email %>
            </a>
        </p>

        <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>

        <h3>Service Projects</h3>

        <% if (projects.length===0) { %>
            <p>No service projects found for this organization.</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } %>
    </main>

    <%- include('partials/footer') %>